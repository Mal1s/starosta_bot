# Client-side (visible in browser, safe to expose)
VITE_DEV_MOCK=true
VITE_BOT_USERNAME=starostaa_help_bot
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Server-side secrets (set in Supabase Edge Function secrets, NOT here) ---
# TELEGRAM_BOT_TOKEN — токен от BotFather
# TELEGRAM_WEBHOOK_SECRET — случайная строка для X-Telegram-Bot-Api-Secret-Token
# BOT_USERNAME — имя бота без @
# APP_URL — адрес Mini App
# GEMINI_API_KEY — ключ Google Gemini
# GEMINI_MODEL — модель Gemini
# ADMIN_TELEGRAM_ID — Telegram ID администратора
# CRON_SECRET — секрет для вызова scheduler-tick из pg_cron
